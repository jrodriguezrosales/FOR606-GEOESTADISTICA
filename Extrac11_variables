// 🛰️ EXTRACCIÓN DE VARIABLES SAR Y OPTICAS - MUNICIPIO HUEHUETLA, PUE.
// ==============================================================================
// 🌍 FOR 606: Geoestadística aplicada en el estudio de los recursos forestales
// 👤 Profesora Titular: Dra. Martha Elva Ramírez Guzman
// 👤 Autor: José Rodriguez Rosales
// 📅 Fecha: Agosto 2026
//
// 📝 Descripción:
// Este script extrae las coordenadas espaciales (easting, northing) junto con 
// un conjunto de covariables ambientales y topográficas para el área de estudio.
//
// 🛰️ Fuentes de información:
// - Imagen SAR (Sentinel-1): Retrodispersión VH, VV, VH/VV, variables de textura.
// - Imagen Óptica (Sentinel-2): NDVI y NDMI.
// - Datos Topográficos: Altitud, Pendiente, TWI (HydroSHEDS).
//
// Variables de salida: X_UTM, Y_UTM, VV_dB, VH_dB, ratio_VHVV_dB, textura_VH_CV, altitud, pendiente_pct, TWI, NDVI, NDMI.
// ==============================================================================

// ============================================================
// 1. ÁREA DE ESTUDIO Y CAPAS VECTORIALES
// ============================================================
var huehuetla = ee.FeatureCollection('projects/hid608/assets/huehuetla_1');
// Capa de puntos generada previamente en QGIS (Muestreo de Hexágonos)
var fc_muestreo = ee.FeatureCollection('projects/hid608/assets/puntos_muestreo_778');

Map.centerObject(huehuetla, 13);
Map.addLayer(huehuetla, {color: 'red', fillColor: '00000000', width: 2}, 'Municipio Huehuetla');

var crs_utm = 'EPSG:32614';
var region_geom = huehuetla.geometry();

// ============================================================
// 2. SENTINEL-1 — RETRODISPERSIÓN SAR
// ============================================================
var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
  .filterBounds(region_geom)
  .filterDate('2025-11-01', '2025-11-30')
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
  .filter(ee.Filter.eq('instrumentMode', 'IW'))
  .filter(ee.Filter.eq('orbitProperties_pass', 'DESCENDING'))
  .first();

// Nota: Las bandas de S1 en GEE ya vienen en decibelios (dB)
var vv_db = s1.select('VV').rename('VV_dB');
var vh_db = s1.select('VH').rename('VH_dB');

// El cociente en dB se calcula mediante resta
var ratio = vh_db.subtract(vv_db).rename('ratio_VHVV_dB');

// Para una textura (CV) matemáticamente correcta, pasamos de dB a escala lineal
var vh_linear = ee.Image(10.0).pow(vh_db.divide(10.0));

// Textura: Coeficiente de Variación (CV = std / mean) en ventana 3x3 sobre valores lineales
var kernel3 = ee.Kernel.square(1, 'pixels');
var vh_mean_lin = vh_linear.reduceNeighborhood({reducer: ee.Reducer.mean(), kernel: kernel3});
var vh_std_lin  = vh_linear.reduceNeighborhood({reducer: ee.Reducer.stdDev(), kernel: kernel3});
var textura = vh_std_lin.divide(vh_mean_lin).rename('textura_VH_CV');

// Apilamos el stack SAR final
var s1_stack = vv_db.addBands(vh_db).addBands(ratio).addBands(textura);

// ============================================================
// 3. SENTINEL-2 — IMAGEN ÓPTICA
// ============================================================
function maskS2(image) {
  var scl = image.select('SCL');
  return image.updateMask(scl.neq(3).and(scl.neq(8)).and(scl.neq(9)).and(scl.neq(10)));
}

// Ventana de búsqueda: ±5 días a partir de la imagen SAR
var s1_date = ee.Date(s1.get('system:time_start'));
var s2 = maskS2(ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(region_geom)
  .filterDate(s1_date.advance(-5, 'day'), s1_date.advance(5, 'day'))
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 60))
  .sort('CLOUDY_PIXEL_PERCENTAGE', true)
  .first());

var ndvi = s2.normalizedDifference(['B8', 'B4']).rename('NDVI');
var ndmi = s2.normalizedDifference(['B8', 'B11']).rename('NDMI');

print('📡 Fecha imagen SAR (S1):', s1_date);
print('🛰️ Fecha imagen S2 seleccionada:', ee.Date(s2.get('system:time_start')));

// ============================================================
// 4. TOPOGRAFÍA — DEM, PENDIENTE Y TWI
// ============================================================
var srtm = ee.Image('USGS/SRTMGL1_003');
var altitud = srtm.rename('altitud');
var slope = ee.Terrain.slope(srtm).multiply(Math.PI/180);
var slope_pct = slope.tan().multiply(100).rename('pendiente_pct');

// TWI con área de contribución específica derivada de HydroSHEDS
var twi = ee.Image('WWF/HydroSHEDS/15ACC').multiply(463)
  .divide(slope.tan().max(0.001)).log().rename('TWI');

// ============================================================
// 5. MUESTREO (Extracción desde el shapefile de QGIS)
// ============================================================
var imagen_final = s1_stack.addBands(altitud).addBands(slope_pct)
  .addBands(twi).addBands(ndvi).addBands(ndmi);

var muestras = imagen_final.sampleRegions({
  collection: fc_muestreo,
  scale: 10,
  projection: crs_utm,
  geometries: true,
  tileScale: 4  // tileScale bajo es suficiente ya que los puntos están definidos
});

print('📍 Total de puntos extraídos con valores válidos:', muestras.size());

// Asignar las coordenadas UTM a las columnas tabulares del dataset
var exportData = muestras.map(function(f) {
  var c = f.geometry().transform(crs_utm, 1).coordinates();
  return f.set('X_UTM', c.get(0)).set('Y_UTM', c.get(1));
});

// ============================================================
// 6. EXPORTACIONES A GOOGLE DRIVE
// ============================================================
Export.table.toDrive({
  collection: exportData,
  description: 'BaseDatos_Kriging_Huehuetla',
  folder: 'GEE_Tesis_Huehuetla',
  fileFormat: 'CSV',
  selectors: ['X_UTM','Y_UTM','VV_dB','VH_dB','ratio_VHVV_dB',
              'textura_VH_CV','altitud','pendiente_pct','TWI','NDVI','NDMI']
});

Export.image.toDrive({
  image: ndvi.toFloat(), 
  description: 'NDVI_S2_Huehuetla',
  folder: 'GEE_Tesis_Huehuetla', 
  region: region_geom, 
  scale: 10, 
  crs: crs_utm, 
  maxPixels: 1e10
});

Export.image.toDrive({
  image: altitud.toFloat(), 
  description: 'DEM_SRTM_Huehuetla',
  folder: 'GEE_Tesis_Huehuetla', 
  region: region_geom, 
  scale: 30, 
  crs: crs_utm, 
  maxPixels: 1e10
});

print('✅ Procesamiento finalizado. Los datos están listos para modelado geoestadístico.');
